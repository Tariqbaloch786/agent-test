{
  "name": "agent-test",
  "version": "1.0.0",
  "private": true,
  "description": "Demo Express app that talks to Stripe with an older API shape. Target repository for API Update Agent.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
