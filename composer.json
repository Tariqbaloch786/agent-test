{
    "name": "demo/billing",
    "description": "Refunds of subscription orders paid through Stripe Checkout (a demo repository for API Update Agent).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^16.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
